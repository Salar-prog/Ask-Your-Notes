# Copy to .env and fill in. Never commit .env.
# With a key here the browser never receives it: serve.mjs answers /api/config
# with key:true and injects the Authorization header itself.
UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
# Pin one model, so the page cannot change it. Leave empty to let the page choose.
UNOROUTER_MODEL=gpt-oss-120b:free

# 127.0.0.1 by default: this process holds a key, so it is not exposed to the LAN.
HOST=127.0.0.1
PORT=8080
